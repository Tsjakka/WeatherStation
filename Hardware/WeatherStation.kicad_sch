	)
	(text "SHT31 sensor board (I2C address 0x44),\nin the radiation shield:\n1 black  = GND\n2 red    = 3.3 V\n3        = SDA (GPIO21)\n4        = SCL (GPIO22)\n(white / yellow: check which is SDA)"
		(exclude_from_sim no)
		(at 312.42 77.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a5069422-338b-5ef1-be03-eb27e2631f70")
	)
	(text "Thies 4.3323.21.002 anemometer cable:\n1 white  = 5 V\n2 brown  = GND (+ cable shield)\n3 green  = wind direction\n4 yellow = wind speed\ngrey = not connected"
